# Copy to .env and fill in. All variables are prefixed IRAG_.

# Only needed from Step 7 (generation) onward. Steps 1-6 run with no API key.
IRAG_ANTHROPIC_API_KEY=

# eval | serve   -- see insurance_rag/config.py for what each profile loads
IRAG_PROFILE=eval

