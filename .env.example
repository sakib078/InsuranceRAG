# Copy to .env and fill in. All variables are prefixed IRAG_.

# Only needed from Step 11 (the agent) onward. Ingestion and retrieval run with no API key.
IRAG_ANTHROPIC_API_KEY=

# qwen3 | bge-m3  -- the encoder under test; see insurance_rag/config.py
IRAG_ENCODER=qwen3

# Postgres 16 + pgvector, brought up by docker/docker-compose.yml
IRAG_POSTGRES_DSN=postgresql://insurance:insurance@localhost:5432/insurance_rag

# Retrieval knobs (defaults in config.py; override here to sweep)
# IRAG_DENSE_TOP_K=20
# IRAG_SPARSE_TOP_K=20
# IRAG_RERANK_TOP_K=5

# Week 5 web tier. Must stay false for every eval run.
IRAG_ENABLE_WEB_FALLBACK=false
