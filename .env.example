# Copy to .env and fill in. Everything is prefixed IRAG_ except the evaluation keys below.

# Generation only. Ingestion and retrieval run with no API key.
# Open-weight model served by Groq: console.groq.com/keys
IRAG_GROQ_API_KEY=
# IRAG_GENERATION_MODEL=llama-3.3-70b-versatile
# Endpoints are listed in insurance_rag/providers.py
# IRAG_GENERATION_PROVIDER=groq     # gemini | groq

# qwen3 | bge-m3  -- the encoder under test; see insurance_rag/config.py
IRAG_ENCODER=qwen3

# Postgres 16 + pgvector. Must be the psycopg3 form
IRAG_POSTGRES_DSN=postgresql+psycopg://user:password@localhost:6024/dbname

# Retrieval knobs (defaults in config.py; override here to sweep)
# IRAG_DENSE_TOP_K=20
# IRAG_SPARSE_TOP_K=20
# IRAG_RERANK_TOP_K=5

# Week 5 web tier. Must stay false for every eval run.
IRAG_ENABLE_WEB_FALLBACK=false

# --- evaluation (Phase 2 onward). Unprefixed: read via validation_alias in config.py ---

# LangSmith holds the dataset and the experiments: smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true

# The judge. A different provider and family from the generator

# aistudio.google.com/apikey -- the judge. 112 calls per generation row, ~7 minutes.
GEMINI_API_EVAL_KEY=
# openrouter.ai/keys -- last judge fallback; 50 requests/day
OPENROUTER_KEY=
